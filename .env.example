# ============================================
# ELTRON DISCORD BOT - Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# NEVER share real secret values.

# Discord Bot
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth2_client_secret
DISCORD_PUBLIC_KEY=your_discord_interactions_public_key

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Dashboard Session
SESSION_SECRET=generate_a_64_char_random_hex_string_for_production

# Bot Owners (comma-separated Discord user IDs)
BOT_OWNERS=your_discord_user_id

# Dashboard API
API_PORT=3001
DASHBOARD_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Environment
NODE_ENV=development
